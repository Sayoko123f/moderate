---
import type { PostEntry } from "@/utils/content";
import { postURL, calcPostFilePath } from "@/utils/url";
import ImageWrapper from "@/components/ImageWrapper.astro";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const postFilePath = calcPostFilePath(post);
---

<article class="mx-6 mt-12 border-b border-neutral pb-10">
  <div class="flex gap-10">
    <div class="min-w-0 flex-1">
      <!-- Title -->
      <a class="block" href={postURL(post)}>
        <h2
          class="text-2xl font-bold leading-snug text-primary transition group-hover:opacity-80"
        >
          {post.data.title}
        </h2>
      </a>

      <!-- Date + Tags -->
      <div
        class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-secondary"
      >
        <time datetime={post.data.published.toISOString()}>
          {post.data.published.toLocaleDateString()}
        </time>

        {
          post.data.tags?.map((tag) => (
            <span class="bg-neutral/20 rounded-md px-2 py-0.5 text-sm">
              {tag}
            </span>
          ))
        }
      </div>

      <!-- Description -->
      <p class="mt-4 max-w-prose text-base leading-relaxed text-secondary">
        {post.data.description}
      </p>
    </div>

    <!-- Cover Image -->
    {
      post.data.cover && (
        <div class="w-[160px] shrink-0">
          <div class="aspect-[3/2] overflow-hidden rounded-lg">
            <ImageWrapper
              classList="w-full h-full object-cover"
              src={post.data.cover}
              entryFilePath={postFilePath}
            />
          </div>
        </div>
      )
    }
  </div>
</article>
